# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Every `change-me` below is rejected by the deploy check that runs before gunicorn
# starts, so a verbatim copy makes `web` exit rather than boot on secrets that are
# published in this repository. That refusal is the intended behaviour, not a bug.
# ---------------------------------------------------------------------------

# --- Public identity -------------------------------------------------------
# Scheme is required. Used for CSRF_TRUSTED_ORIGINS, absolute og:image URLs,
# feed links, and the canonical URL posted to Mastodon in P2.
SITE_URL=https://remembrancer.example
SITE_NAME=Remembrancer
DJANGO_ALLOWED_HOSTS=remembrancer.example,web,localhost,127.0.0.1
# Hostname Caddy answers on and requests a certificate for. Use ":80" to serve plain
# HTTP locally (pair it with DJANGO_DEBUG=true, or the SSL redirect will loop).
SITE_HOST=remembrancer.example

# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-64-char-random-string
DJANGO_DEBUG=false
# Non-obvious admin path (no leading/trailing slash). Part of the hardening in
# Decision 14 -- it is obscurity, not security, but it removes the bot floor.
DJANGO_ADMIN_PATH=steward

# --- Datastores ------------------------------------------------------------
POSTGRES_DB=remembrancer
POSTGRES_USER=remembrancer
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://remembrancer:change-me@postgres:5432/remembrancer
REDIS_URL=redis://redis:6379/0

# --- Audiobookshelf --------------------------------------------------------
# Base URL of your publicly reachable ABS instance, no trailing slash.
# Cover downloads are pinned to this host (SSRF guard), so it must be exact.
ABS_BASE_URL=https://abs.example
# Long-lived bearer token: POST /login -> response.user.token, or an
# admin-created API key on newer builds.
ABS_TOKEN=
# Optional comma-separated library IDs. Empty = every book library.
ABS_LIBRARY_IDS=

# --- Next.js revalidation --------------------------------------------------
# Shared HMAC secret between Django and Next. The hook is only reachable on the
# internal docker network; this is defence in depth, not the sole control.
REVALIDATE_SECRET=change-me-generate-a-64-char-random-string
# Internal address Django uses to reach Next. Not public.
NEXT_INTERNAL_URL=http://next:3000

# --- Frontend --------------------------------------------------------------
# Internal address Next uses to reach Django during SSG/ISR. Not public.
DJANGO_INTERNAL_URL=http://web:8000
# Next reads SITE_URL/SITE_NAME from above at render time. Nothing is baked into the
# image, so the published container works on any domain.

# --- Impressum (§5 DDG) ------------------------------------------------------
# Rendered on /legal. Required before the site is publicly reachable: name, street,
# city and email. Until all four are set the page says so instead of pretending.
# Kept out of the image so it is correctable without a rebuild.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_CITY=
IMPRESSUM_COUNTRY=Deutschland
IMPRESSUM_EMAIL=
# Optional.
IMPRESSUM_PHONE=
IMPRESSUM_VAT_ID=
# Only needed for journalistic-editorial content (§18 Abs. 2 MStV). Reviews under
# your own name generally are; leave blank if unsure and take advice.
IMPRESSUM_EDITORIAL_RESPONSIBLE=
# Named in the DSGVO rights section, e.g. "Der Bayerische Landesbeauftragte für den
# Datenschutz". Optional.
IMPRESSUM_SUPERVISORY_AUTHORITY=

# --- Released images ---------------------------------------------------------
# Pin a published build (git sha or version tag). Empty = latest from main.
IMAGE_TAG=
