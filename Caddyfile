{$SITE_HOST} {
	encode zstd gzip

	# Same origin for everything. This is what removes CORS config and cross-site
	# CSRF from the design entirely -- see Decision 12.

	header {
		# Everything is first-party and self-hosted: no external scripts, no CDN
		# fonts (next/font inlines them at build), no third-party analytics.
		#
		# script-src needs 'unsafe-inline' because Next.js emits inline bootstrap and
		# RSC-payload scripts. The alternative -- per-request nonces -- forces every
		# page into dynamic rendering, which would defeat the static caching that
		# Decisions 8 and 10 depend on. Without it the site does not hydrate at all.
		# The real XSS control is server-side: review Markdown is sanitized with nh3
		# before it ever leaves Django, and there is no other user-supplied content.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		-Server
	}

	# Covers, written by the sync job into the shared media volume.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Django owns the API, the admin, the feed, and its own static files.
	# Consequence worth knowing: Next can never own a public /api/* route, which is
	# precisely why its internal /api/revalidate hook is unreachable from outside.
	@django path /api/* /feed.xml /static/* /{$DJANGO_ADMIN_PATH:admin}/*
	handle @django {
		reverse_proxy web:8000 {
			# Without this, Django never sees a secure request and SECURE_SSL_REDIRECT
			# becomes an infinite loop.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else is the statically-generated Next.js site.
	handle {
		reverse_proxy next:3000
	}
}
